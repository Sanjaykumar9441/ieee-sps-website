<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>National Space Day 2026</title>
</head>
<body style="margin:0; padding:0; background:#F1F5F9; font-family:Arial, Helvetica, sans-serif;">

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#F1F5F9;">
    <tr>
      <td align="center" style="padding:40px 20px;">

        <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="width:600px; max-width:600px; background:#FFFFFF; border-radius:18px; overflow:hidden;">

          <!-- Header -->
          <tr>
            <td style="padding:44px 40px 32px; text-align:center; border-bottom:5px solid <%= primaryColor %>;">
              <h1 style="margin:0 0 10px; font-size:26px; line-height:32px; color:<%= primaryColor %>; font-weight:700;">
                National Space Day 2026
              </h1>
              <p style="margin:0 0 4px; font-size:16px; color:#475569;">
                IEEE SPS Student Branch Chapter
              </p>
              <p style="margin:0; font-size:14px; color:#94A3B8;">
                Aditya University
              </p>
            </td>
          </tr>

          <!-- Body -->
          <tr>
            <td style="padding:44px 40px;">

              <h2 style="margin:0 0 28px; font-size:22px; line-height:28px; text-align:center; color:#0F172A;">
                Registration Successfully Verified
              </h2>

              <table role="presentation" cellpadding="0" cellspacing="0" style="margin:0 auto 32px;">
                <tr>
                  <td style="background:#DCFCE7; color:#15803D; padding:10px 26px; border-radius:999px; font-size:15px; font-weight:bold; text-align:center;">
                    &#128994; VERIFIED
                  </td>
                </tr>
              </table>

              <p style="margin:0 0 16px; font-size:15px; line-height:24px; color:#334155;">
                Hello <strong><%= participantName %></strong>,
              </p>

              <p style="margin:0 0 32px; font-size:15px; line-height:24px; color:#334155;">
                Congratulations! Your payment has been verified successfully and your registration is confirmed.
              </p>

              <!-- Details card -->
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #E2E8F0; border-radius:12px; margin-bottom:32px;">
                <tr>
                  <td style="padding:24px 28px;">

                    <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
                      <tr>
                        <td style="padding-bottom:16px;">
                          <p style="margin:0 0 4px; font-size:13px; color:#64748B;">Registration ID</p>
                          <p style="margin:0; font-size:16px; font-weight:bold; color:#0F172A;"><%= registrationId %></p>
                        </td>
                      </tr>
                      <tr>
                        <td style="border-top:1px solid #E2E8F0; padding:16px 0;">
                          <p style="margin:0 0 4px; font-size:13px; color:#64748B;">Event</p>
                          <p style="margin:0; font-size:16px; font-weight:bold; color:#0F172A;"><%= eventName %></p>
                        </td>
                      </tr>
                      <tr>
                        <td style="border-top:1px solid #E2E8F0; padding-top:16px;">
                          <p style="margin:0 0 4px; font-size:13px; color:#64748B;">Payment Status</p>
                          <p style="margin:0; font-size:16px; font-weight:bold; color:#16A34A;"><%= paymentStatus %></p>
                        </td>
                      </tr>
                    </table>

                  </td>
                </tr>
              </table>

              <!-- Acknowledgement note -->
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#EFF6FF; border-radius:12px; margin-bottom:32px;">
                <tr>
                  <td style="padding:22px 26px;">
                    <p style="margin:0 0 8px; font-size:15px; font-weight:bold; color:#0F172A;">
                      &#128196; Verified Acknowledgement
                    </p>
                    <p style="margin:0; font-size:14px; line-height:22px; color:#475569;">
                      Your verified acknowledgement PDF has been attached with this email. Please download and keep it safe.
                    </p>
                  </td>
                </tr>
              </table>

              <!-- Buttons -->
              <table role="presentation" cellpadding="0" cellspacing="0" style="margin:0 auto;">
                <tr>
                  <td style="padding-bottom:14px;" align="center">
                    <a href="<%= whatsappLink %>" style="background:#16A34A; color:#FFFFFF; padding:14px 32px; border-radius:10px; text-decoration:none; display:inline-block; font-size:15px; font-weight:bold;">
                      Join Event WhatsApp Group
                    </a>
                  </td>
                </tr>
                <tr>
                  <td align="center">
                    <a href="<%= statusLink %>" style="background:<%= primaryColor %>; color:#FFFFFF; padding:14px 32px; border-radius:10px; text-decoration:none; display:inline-block; font-size:15px; font-weight:bold;">
                      View Registration Status
                    </a>
                  </td>
                </tr>
              </table>

            </td>
          </tr>

          <!-- Help section -->
          <tr>
            <td style="padding:0 40px 44px;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#F8FAFC; border-radius:12px;">
                <tr>
                  <td style="padding:24px 28px;">
                    <p style="margin:0 0 14px; font-size:15px; font-weight:bold; color:#0F172A;">
                      Need Assistance?
                    </p>
                    <p style="margin:0 0 8px; font-size:14px; line-height:22px; color:#475569;">
                      &#128231; ieee.club.aus@gmail.com
                    </p>
                    <p style="margin:0 0 8px; font-size:14px; line-height:22px; color:#475569;">
                      &#128222; +91 7095009441
                    </p>
                    <p style="margin:0; font-size:14px; line-height:22px; color:#475569;">
                      &#127760; https://ieeespsaditya.vercel.app
                    </p>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="background:#F1F5F9; padding:32px 40px; text-align:center;">
              <p style="margin:0 0 6px; font-size:15px; font-weight:bold; color:#0F172A;">
                IEEE SPS Student Branch Chapter
              </p>
              <p style="margin:0 0 6px; font-size:14px; color:#64748B;">
                Aditya University
              </p>
              <p style="margin:0 0 14px; font-size:14px; color:#64748B;">
                Explore &bull; Innovate &bull; Inspire
              </p>
              <p style="margin:0; font-size:12px; color:#94A3B8;">
                &copy; 2026 IEEE SPS Student Branch Chapter
              </p>
              <p style="
margin-top:18px;
font-size:12px;
color:#94A3B8;
line-height:18px;
">

This is an automated email from the IEEE SPS Student Branch Chapter.
Please do not reply directly to this message.

</p>
            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>

</body>
</html>
